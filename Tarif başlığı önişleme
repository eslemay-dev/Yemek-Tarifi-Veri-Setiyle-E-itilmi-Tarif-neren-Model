import re
import pandas as pd
import json

with open("3000_Yemek_TarifiSonHal.txt", "r", encoding="utf-8") as f:
    text = f.read()

# Tarifleri başlığa göre böl
tarifler = re.split(r"\n(?=[A-ZÇĞİÖŞÜ].*? - \d+)", text.strip())
veriler = []

for tarif in tarifler:
    # Başlık
    baslik = re.search(r"^(.*?)-\s*\d+", tarif)

    # Süre: sadece o satırı yakalar (newline öncesi bitiş zorunlu)
    sure = re.search(r"Süre:\s*([^\n\r]+)", tarif)

    # Malzemeler
    malzemeler = re.search(r"MALZEMELER\s*(.*?)(?=\n\s*YAPILIŞ TARİFİ)", tarif, re.S)

    # Yapılış
    yapilis = re.search(
        r"YAPILIŞ TARİFİ\s*(.*?)(?=\n[A-ZÇĞİÖŞÜ].*? - \d+|\Z)", tarif, re.S
    )

    if not baslik or "None" in baslik.group(1):
        continue

    data = {
        "baslik": baslik.group(1).strip(),
        "malzemeler": malzemeler.group(1).strip().replace("\n", " ") if malzemeler else None,
        "yapilis_tarifi": yapilis.group(1).strip().replace("\n", " ") if yapilis else None,
        "pisirme_suresi": sure.group(1).strip() if sure else None
    }

    veriler.append(data)

df = pd.DataFrame(veriler)

df["baslik"] = df["baslik"].str.strip()
df["malzemeler"] = df["malzemeler"].str.replace(r"\s+", " ", regex=True)
df["yapilis_tarifi"] = df["yapilis_tarifi"].str.replace(r"\s+", " ", regex=True)

# JSON kaydet
json_path = "3000tarifler_ortak_duzeltilmis.json"
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(df.to_dict(orient="records"), f, ensure_ascii=False, indent=4)

print(f"{len(df)} tarif başarıyla {json_path} dosyasına kaydedildi!")
