
import json
import torch
from datasets import Dataset
from transformers import (
    AutoTokenizer,
    AutoModelForCausalLM,
    TrainingArguments,
    Trainer,
    DataCollatorForLanguageModeling
)
from peft import LoraConfig, get_peft_model

with open("llama_dataset.json", "r", encoding="utf-8") as f:
    data = json.load(f)

dataset = Dataset.from_list(data)
dataset = dataset.train_test_split(test_size=0.1, seed=42)

train_data = dataset["train"]
val_data = dataset["test"]

print("Train:", len(train_data))
print("Val:", len(val_data))

model_name = "meta-llama/Llama-3.2-3B-Instruct"

#tokenizer yüklendi
tokenizer = AutoTokenizer.from_pretrained(model_name)
tokenizer.pad_token = tokenizer.eos_token

def tokenize_function(example):
    texts = []

    for p, r in zip(example["prompt"], example["response"]):
        text = (
            "<|user|>\n"
            + str(p)
            + "\n<|assistant|>\n"
            + str(r)
        )
        texts.append(text)

    tokens = tokenizer(
        texts,
        truncation=True,
        padding="max_length",
        max_length=512,
    )

    labels = []
    assistant_token = tokenizer.encode("<|assistant|>", add_special_tokens=False)

    for input_ids in tokens["input_ids"]:
        label = input_ids.copy()
        start_idx = None

        for i in range(len(label) - len(assistant_token)):
            if label[i:i+len(assistant_token)] == assistant_token:
                start_idx = i + len(assistant_token)
                break

        if start_idx is not None:
            label[:start_idx] = [-100] * start_idx
        else:
            label = [-100] * len(label)

        labels.append(label)

    tokens["labels"] = labels
    return tokens

# TOKENIZE
train_tokenized = train_data.map(tokenize_function, batched=True)
val_tokenized = val_data.map(tokenize_function, batched=True)

print("Train:", len(train_tokenized))
print("Val:", len(val_tokenized))

sample = train_tokenized[0]

print("\nINPUT IDS (ilk 50):")
print(sample["input_ids"][:50])

print("\nLABELS (ilk 50):")
print(sample["labels"][:50])
